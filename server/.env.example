# MySQL Database connection (host.docker.internal connects to host machine's MySQL)
DATABASE_URL="mysql+pymysql://<DB_USER>:<DB_PASSWORD>@host.docker.internal:3306/visuai"

# Application Security
SECRET_KEY="your_random_secret_key_base64_or_string"
ADMIN_ACTION_PASSWORD="your_admin_action_password"

# Allowed CORS Origins (comma-separated, optional)
CORS_ORIGINS="https://service.npc.ac.th"

# Gmail SMTP Settings
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASSWORD="your_gmail_app_password"
